---
import { getCollection } from "astro:content";
import Card from "./Card.astro";
import Dots from "./Dots.astro";
import ChevronDown from "../icons/ChevronDown.astro";

const { class: className } = Astro.props;

// Get current date in UK timezone
const now = new Date();
const ukDate = new Date(
  now.toLocaleString("en-US", { timeZone: "Europe/London" }),
);
ukDate.setHours(0, 0, 0, 0);

// Filter tournaments to only show tournaments happening today or later.
// Undated tournaments remain visible because their date is still TBC.
const allTournaments = await getCollection("tournaments");
const futureTournaments = allTournaments.filter((tournament) => {
  const tournamentDate = tournament.data.date;
  if (tournamentDate === null) return true;
  tournamentDate.setHours(0, 0, 0, 0);
  return tournamentDate >= ukDate;
});
const tournaments = futureTournaments;
const difficultyLevels = ["No dots", "Novice", "Medium", "Hard", "Very hard"];
---

<div class={className} data-tournaments>
  <h2>Upcoming tournaments</h2>
  <form hidden class="mb-6" data-tournament-filters>
    <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
      <details class="group relative" name="tournament-filter">
        <summary
          class="bg-ukqb-red-bg hover:bg-ukqb-red-hover flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-lg border-1 border-gray-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Eligibility
          <ChevronDown
            class="size-5 transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <fieldset class="navbar-dropdown-items filter-options m-0 mt-2">
          <legend class="sr-only">Eligibility</legend>
          <label class="dropdown-item min-h-11 flex-row items-center px-3 py-2">
            <input
              class="accent-ukqb-red size-4 shrink-0"
              type="checkbox"
              name="eligibility"
              value="open"
              checked
            />
            Open
          </label>
          <label class="dropdown-item min-h-11 flex-row items-center px-3 py-2">
            <input
              class="accent-ukqb-red size-4 shrink-0"
              type="checkbox"
              name="eligibility"
              value="closed"
              checked
            />
            Closed (student-only)
          </label>
        </fieldset>
      </details>
      <details class="group relative" name="tournament-filter">
        <summary
          class="bg-ukqb-red-bg hover:bg-ukqb-red-hover flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-lg border-1 border-gray-300 px-4 py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          Difficulty
          <ChevronDown
            class="size-5 transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <fieldset class="navbar-dropdown-items filter-options m-0 mt-2">
          <legend class="sr-only">Difficulty</legend>
          {
            difficultyLevels.map((label, dots) => (
              <label class="dropdown-item min-h-11 flex-row items-center px-3 py-2">
                <input
                  class="accent-ukqb-red size-4 shrink-0"
                  type="checkbox"
                  name="difficulty"
                  value={dots}
                  checked
                />
                <span class="flex items-center gap-2">
                  <span aria-hidden="true">
                    <Dots dots={dots} />
                  </span>
                  <span>
                    {label}
                    <span class="sr-only"> ({dots} dots)</span>
                  </span>
                </span>
              </label>
            ))
          }
        </fieldset>
      </details>
    </div>
  </form>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8 2xl:grid-cols-3">
    {
      tournaments.map((tournament) => (
        <div
          data-tournament
          data-eligibility={tournament.data.eligibility}
          data-dots={tournament.data.dots}
        >
          <Card tournament={tournament} />
        </div>
      ))
    }
  </div>
  <p role="status" data-tournament-status></p>
</div>

<script>
  import { matchesTournamentFilters } from "./filters.js";

  document
    .querySelectorAll<HTMLElement>("[data-tournaments]")
    .forEach((section) => {
      const form = section.querySelector<HTMLFormElement>(
        "[data-tournament-filters]",
      )!;
      const cards = section.querySelectorAll<HTMLElement>("[data-tournament]");
      const status = section.querySelector<HTMLElement>(
        "[data-tournament-status]",
      )!;

      const update = () => {
        const selected = new FormData(form);
        const eligibility = selected.getAll("eligibility").map(String);
        const difficulties = selected.getAll("difficulty").map(Number);
        let count = 0;

        cards.forEach((card) => {
          card.hidden = !matchesTournamentFilters(
            card.dataset.eligibility!,
            Number(card.dataset.dots),
            eligibility,
            difficulties,
          );
          if (!card.hidden) count++;
        });

        status.textContent =
          count === 0
            ? "No tournaments match these filters."
            : `${count} ${count === 1 ? "tournament" : "tournaments"} shown.`;
      };

      document.addEventListener("click", (event) => {
        form
          .querySelectorAll<HTMLDetailsElement>("details[open]")
          .forEach((dropdown) => {
            if (
              event.target instanceof Node &&
              !dropdown.contains(event.target)
            ) {
              dropdown.open = false;
            }
          });
      });
      form.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const dropdown =
            form.querySelector<HTMLDetailsElement>("details[open]");
          if (dropdown) {
            dropdown.open = false;
            dropdown.querySelector("summary")?.focus();
          }
        }
      });

      form.addEventListener("submit", (event) => event.preventDefault());
      form.addEventListener("change", update);
      form.hidden = false;
      update();
    });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .filter-options {
    left: 0;
    z-index: 10;
    box-sizing: border-box;
    width: 100%;
    transform: none;
    translate: none;
    min-inline-size: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .filter-options {
      width: max-content;
      min-width: 100%;
    }
  }
</style>
