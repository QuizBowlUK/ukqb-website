---
const inputClasses =
  "w-full max-w-xs rounded-xl border border-gray-300 px-4 py-3 text-lg";
const buttonClasses =
  "bg-ukqb-red w-full max-w-xs cursor-pointer rounded-xl border-none px-6 py-3.5 text-xl text-white transition duration-100 ease-in hover:bg-red-700 md:w-auto md:px-8";
---

<section class="mt-20 text-center md:mt-40">
  <h2 class="text-2xl md:text-3xl">Open mailing list</h2>
  <p class="mx-auto mt-3 max-w-xl">
    Occasional emails about tournaments, opportunities and other UK quizbowl
    news. No spam.
  </p>
  <form
    method="post"
    action="/api/subscribe"
    class="mt-6 flex flex-col items-center justify-center gap-3 md:flex-row"
  >
    <label class="sr-only" for="mailing-list-email">Email address</label>
    <input
      class={inputClasses}
      id="mailing-list-email"
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <input
      class="hidden"
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <button class={buttonClasses} type="submit">Sign up</button>
  </form>
</section>
