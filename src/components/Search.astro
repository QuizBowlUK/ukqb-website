---
// Site-wide search: a floating trigger that opens a modal, so the page layout
// does not change. The index is built by `npm run build` (postbuild script).
---

{
  /* Loaded here rather than from the script, so the markup is never unstyled */
  import.meta.env.PROD && (
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  )
}

<button
  id="search-trigger"
  type="button"
  hidden
  aria-label="Search the site"
  aria-expanded="false"
  aria-controls="search-overlay"
  class="bg-ukqb-red-hover text-ukqb-red group fixed right-4 bottom-4 z-40 flex h-12 items-center justify-center gap-0 rounded-full px-3.5 transition-all duration-200 hover:gap-2.5 hover:bg-[#f8dddd] sm:right-6 sm:bottom-6"
  data-pagefind-ignore
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-5 w-5 shrink-0"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"
    >
    </path>
  </svg>
  <!-- Collapsed to a circle until the pointer is over it, so it stays out of the way -->
  <span
    class="max-w-0 overflow-hidden text-sm font-semibold whitespace-nowrap opacity-0 transition-all duration-200 group-hover:max-w-24 group-hover:opacity-100"
  >
    Search
  </span>
</button>

<div
  id="search-overlay"
  class="fixed inset-0 z-50 box-border hidden overflow-hidden bg-black/40 p-3 sm:overflow-y-auto sm:p-6"
  data-pagefind-ignore
>
  <div
    id="search-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Search the site"
    class="bg-ukqb-red-bg mx-auto box-border h-full w-full max-w-2xl rounded-xl border border-gray-300 p-3 sm:mt-[8vh] sm:h-auto"
  >
    <div id="search-bar" class="flex items-center gap-1">
      <div id="site-search" class="min-w-0 flex-1"></div>
      <button
        id="search-close"
        type="button"
        aria-label="Close search"
        class="text-ukqb-red hover:bg-ukqb-red-hover flex h-10 w-10 shrink-0 items-center justify-center rounded-lg sm:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          >
          </path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById("search-trigger");
  const overlay = document.getElementById("search-overlay");
  const container = document.getElementById("site-search");

  function searchInput() {
    return container?.querySelector<HTMLInputElement>(
      ".pagefind-ui__search-input",
    );
  }

  const viewport = window.visualViewport;
  let savedScrollY = 0;

  // The on-screen keyboard shrinks the visual viewport without resizing the
  // layout viewport, so the dialog follows what the user can actually see.
  // The overlay keeps covering the whole page, so nothing unshaded shows.
  function fitToVisibleViewport() {
    if (!viewport || !isOpen()) return;
    document.documentElement.style.setProperty(
      "--search-vv-height",
      `${viewport.height}px`,
    );
    document.documentElement.style.setProperty(
      "--search-vv-offset",
      `${viewport.offsetTop}px`,
    );
  }

  // Fixed body keeps the page behind the dialog from scrolling, and restores
  // the scroll position on close
  function lockPageScroll() {
    savedScrollY = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${savedScrollY}px`;
    document.body.style.width = "100%";
  }

  function unlockPageScroll() {
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.width = "";
    window.scrollTo(0, savedScrollY);
  }

  function openSearch() {
    if (!overlay || !trigger) return;
    overlay.classList.remove("hidden");
    fitToVisibleViewport();
    requestAnimationFrame(fitToVisibleViewport);
    trigger.setAttribute("aria-expanded", "true");
    lockPageScroll();
    searchInput()?.focus();
  }

  function closeSearch() {
    if (!overlay || !trigger) return;
    overlay.classList.add("hidden");
    trigger.setAttribute("aria-expanded", "false");
    unlockPageScroll();
    // Start fresh the next time it opens
    (
      document.querySelector(".pagefind-ui__search-clear") as HTMLElement | null
    )?.click();
    trigger.focus();
  }

  viewport?.addEventListener("resize", fitToVisibleViewport);
  viewport?.addEventListener("scroll", fitToVisibleViewport);

  function isOpen() {
    return !!overlay && !overlay.classList.contains("hidden");
  }

  trigger?.addEventListener("click", openSearch);
  document
    .getElementById("search-close")
    ?.addEventListener("click", closeSearch);

  overlay?.addEventListener("click", (event) => {
    if (event.target === overlay) closeSearch();
  });

  document.addEventListener(
    "keydown",
    (event) => {
      if (event.key === "Escape" && isOpen()) closeSearch();

      // "/" or Cmd/Ctrl+K opens the search, unless the user is typing
      const typing = (event.target as HTMLElement)?.closest(
        "input, textarea, select, [contenteditable]",
      );
      if (typing) return;
      const isShortcut =
        event.key === "/" ||
        (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey));
      if (!isShortcut || !trigger || trigger.hidden) return;
      event.preventDefault();
      openSearch();
    },
    true,
  );

  async function initSearch() {
    if (!container || !import.meta.env.PROD) return;

    try {
      // pagefind-ui.js is a plain script, not a module: it defines window.PagefindUI
      await new Promise((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = resolve;
        script.onerror = () => reject(new Error("No search index"));
        document.head.append(script);
      });

      new (window as any).PagefindUI({
        element: "#site-search",
        showImages: false,
        showSubResults: false,
        // Show every match: the index is small, so there is no "Load more" step
        pageSize: 1000,
        // The reset stylesheet uses `all: unset`, which fights the site styles
        resetStyles: false,
        translations: { placeholder: "Search the site" },
      });

      if (trigger) trigger.hidden = false;
    } catch {
      // No index available, e.g. in dev: leave the trigger hidden
    }
  }

  initSearch();
</script>
