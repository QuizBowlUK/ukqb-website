---
import Header from "../components/Header.astro";
import "../styles/global.css";
import { getLastUpdated } from "../utils/lastUpdated.js";

export interface Props {
  title?: string;
  sourceFiles: string[];
}

const { title, sourceFiles } = Astro.props;
const fullTitle = title ? `${title} • UK Quizbowl` : "UK Quizbowl";
const lastUpdated = getLastUpdated(sourceFiles);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#da532c" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fffafa" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body class="bg-ukqb-red-bg m-0 p-0">
    <div class="container mx-auto">
      <!-- The final max width excludes the padding, so if we put the padding in the
           container div above, the actual max width is [max width defined in container class
           + padding] which causes the contents to overflow -->
      <div class="px-5 md:px-10">
        <Header />
      </div>
      <div class="px-5 md:px-20 lg:px-40">
        <slot />
        <footer class="mx-auto mt-12 mb-8 text-center text-sm text-gray-600">
          Last updated: <time datetime={lastUpdated.toISOString()}>
            {
              lastUpdated.toLocaleString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                hourCycle: "h23",
                timeZone: "Europe/London",
                timeZoneName: "short",
              })
            }
          </time>
        </footer>
      </div>
    </div>
  </body>
</html>
